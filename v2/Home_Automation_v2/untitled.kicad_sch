	(text "R_in = 12k\nR_rx = 12k/32 = 375\n\nR_t = 120|| 120 = 60\n\nR_AB = 60||375 =51.72\n\nV_cc = 3.135V\n\n1% R Bias ignored (too small for small R)\n\nV_AB = 3.135*51.72 / (330+330+51.72) \nV_AB = 228mV > 200mV\nI_AB = 4.36 mA"
